# Detect text automatically without rewriting existing working files.
* text=auto
.gitignore text eol=lf
.env.example text eol=lf

# Linux/container scripts must use LF on every workstation.
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
# PLANO uses two trailing spaces for intentional Markdown line breaks.
docs/PLANO.md whitespace=-blank-at-eol
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Geographic originals are evidence: preserve exact bytes, including metadata line endings.
/geography/**/*.original.* -text
