# Exemplo de desenvolvimento; nao contem credenciais utilizaveis.
# O .env real existente deve ser preservado e permanecer fora do Git.
# Ao preparar um NOVO ambiente em P01, definir senha local exclusiva.
POSTGRES_DB=voz_da_rua
POSTGRES_USER=vozrua
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Identidade de bootstrap do Compose existente, nao credencial aprovada
# para trafego do backend. Separar usuario de aplicacao/migration em P01.
APP_ENV=development
MIGRATION_DB_USER=vozrua_migrator
MIGRATION_DB_PASSWORD=
APP_DB_USER=vozrua_app
APP_DB_PASSWORD=
DB_HOST=localhost
BACKEND_PORT=8080
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
ALLOW_DEV_SEED=false

# Storage opcional permanece bloqueado ate revisao de origem/imagem MinIO.
# Nao preencher com imagem legada vulneravel nem substituir a tecnologia.
MINIO_IMAGE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

TZ=America/Sao_Paulo
